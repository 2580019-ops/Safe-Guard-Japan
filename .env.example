# GEMINI_API_KEY: Optional if AI capabilities are used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional backend API origin for production static hosting (for example, GitHub Pages).
# Leave unset to use local fallback data without making unavailable API requests.
# VITE_API_BASE_URL="https://api.example.com"

# Server Port
PORT=3000

# MariaDB / Database Configuration (for Spring Boot backend)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="safeguard_db"
DB_USER="safeguard_app"
DB_PASSWORD="safeguard_secret_pass"

# JMA Data Client Config
JMA_QUAKE_URL="https://www.jma.go.jp/bosai/quake/data/list.json"
JMA_TIMEOUT_SECONDS=3
JMA_CACHE_SECONDS=60
